# Anthropic Claude (direct API)
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Google Gemini
# GEMINI_API_KEY=AIza-your-key-here

# OpenAI
# OPENAI_API_KEY=sk-your-key-here

# External MCP server credentials (referenced via ${VAR} in archguard.yaml external.env)

# Notion — integration token (Settings → Connections → Develop or manage integrations).
# Pages must be explicitly shared with the integration via the Share menu, otherwise
# API-post-search returns an empty result set.
# NOTION_API_TOKEN=ntn_xxxxxxxxxxxxxxxxx

# YouTrack Cloud — permanent token (Profile → Account Security → New token).
# YOUTRACK_URL=https://your-org.youtrack.cloud
# YOUTRACK_TOKEN=perm:base64-encoded-token

# Atlassian Cloud / Jira — email + API token (id.atlassian.com → Security → API tokens).
# JIRA_URL=https://your-org.atlassian.net
# JIRA_USERNAME=you@example.com
# JIRA_API_TOKEN=ATATT3xFfGF0...
# Optional: comma-separated project keys to scope jira_search to. Maps to
# JIRA_PROJECTS_FILTER inside the mcp-atlassian subprocess.
# JIRA_PROJECT_KEY=YOUR-PROJECT

# Debug: print raw external context fetched from each system before analysis starts.
# ARCHGUARD_DEBUG_EXTERNALS=true

# Project scoping for archguard external context (used via ${VAR} in archguard.yaml project_filter).
# Set to the project key/ID that archguard should restrict external queries to.
# JIRA_PROJECT_KEY is already declared above — reuse it for project_filter in archguard.yaml.
# YOUTRACK_PROJECT_KEY=YOUR-PROJECT
